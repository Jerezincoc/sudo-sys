{
  "name": "@sudo-sys/app-host",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main/main.js",
  "scripts": {
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron electron-dev.cjs",
    "electron:dev:preload": "tsc -p tsconfig.json --noEmitOnError false",
    "build": "tsc -p tsconfig.json",
    "dist": "electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sudo-sys/application": "workspace:*",
    "@sudo-sys/domain": "workspace:*",
    "@sudo-sys/infrastructure": "workspace:*",
    "@sudo-sys/shared": "workspace:*",
    "better-sqlite3": "^11.1.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/pg": "^8.11.6",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.5",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  },
  "build": {
    "appId": "br.com.sudosys",
    "productName": "SudoSys",
    "directories": {
      "output": "dist/electron"
    },
    "files": [
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}