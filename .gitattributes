# Normaliza todos os arquivos de texto para LF no repositorio
* text=auto eol=lf

# Forcado para LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.toml  text eol=lf
*.sh    text eol=lf

# Binarios - sem conversao
*.png   binary
*.jpg   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary